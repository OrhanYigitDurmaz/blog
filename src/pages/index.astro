---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Orhan Durmaz - Minimalist Portfolio">
    <section class="mb-24 animate-fade-in-up">
        <h1
            class="text-4xl md:text-6xl font-bold mb-6 text-text-light dark:text-white"
        >
            Hi, I am <span class="text-primary">Orhan</span><span
                class="text-primary cursor-blink">.</span
            >
        </h1>
        <p
            class="text-lg md:text-xl leading-relaxed text-gray-600 dark:text-gray-300 max-w-2xl"
        >
            <span class="text-primary font-bold mr-2">&gt;</span>
            Full Stack Developer building accessible, pixel-perfect, and performant
            web experiences.
        </p>
    </section>

    <section class="mb-20">
        <h2 class="text-2xl font-bold mb-6 flex items-center group">
            <span
                class="text-primary mr-2 group-hover:translate-x-1 transition-transform"
                >##</span
            >
            <span class="text-text-light dark:text-white">Who am I?</span>
        </h2>
        <div
            class="space-y-6 text-gray-600 dark:text-gray-400 leading-relaxed text-base md:text-lg"
        >
            <p>
                I'm a software engineer based in the digital ether. My journey
                started with a simple HTML file and has evolved into
                architecting complex distributed systems.
            </p>
            <p>
                I believe in open source, clean code, and the idea that
                technology should empower people. When I'm not coding, you can
                find me tinkering with <span class="text-primary font-bold"
                    >IoT devices</span
                > or exploring the latest in generative AI.
            </p>
        </div>
    </section>

    <section class="mb-20">
        <h2 class="text-2xl font-bold mb-6 flex items-center group">
            <span
                class="text-primary mr-2 group-hover:translate-x-1 transition-transform"
                >##</span
            >
            <span class="text-text-light dark:text-white">What I do</span>
        </h2>
        <div
            class="text-gray-600 dark:text-gray-400 leading-relaxed text-base md:text-lg mb-8"
        >
            <p>
                I leverage a modern tech stack to bring ideas to life. I focus
                on creating intuitive interfaces backed by robust logic.
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div
                class="p-4 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-primary dark:hover:border-primary transition-colors group"
            >
                <h3 class="text-primary font-bold mb-2 flex items-center">
                    <span class="material-icons text-sm mr-2">code</span> Frontend
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    React, Vue, Tailwind CSS, TypeScript. Crafting responsive
                    and interactive UIs.
                </p>
            </div>
            <div
                class="p-4 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-primary dark:hover:border-primary transition-colors group"
            >
                <h3 class="text-primary font-bold mb-2 flex items-center">
                    <span class="material-icons text-sm mr-2">dns</span> Backend
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Node.js, Go, Python, PostgreSQL. Building scalable APIs and
                    services.
                </p>
            </div>
        </div>
    </section>

    <section class="mt-24 pt-12 border-t border-gray-200 dark:border-gray-800">
        <p class="text-gray-500 dark:text-gray-400 mb-4">
            <span class="text-primary">&gt;</span> Ready to start a project?
        </p>
        <a
            class="inline-flex items-center text-xl font-bold text-text-light dark:text-white hover:text-primary dark:hover:text-primary transition-colors decoration-2 hover:underline underline-offset-4"
            href="mailto:hello@orhandurmaz.dev"
        >
            Get in touch <span class="material-icons ml-2">arrow_forward</span>
        </a>
    </section>
</MainLayout>
